  "process": {
    "texts": [
      {
        "text": "From mapping the systems to watching them run.",
        "size": 40,
        "weight": 400,
        "family": "TWK Everett"
      },
      {
        "text": "How We Integrate",
        "size": 15,
        "weight": 400,
        "family": "TWK Everett"
      },
      {
        "text": "Audit & Map",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "Plan the Data Flow",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "We list every system, what data each one owns and where things break today before proposing anything.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      },
      {
        "text": "We decide direction, frequency and what wins when two systems disagree, which is where most integrations fail.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      },
      {
        "text": "Launch & Monitor",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "Build & Test",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "We watch it under real volume and keep alerting on it, because a silent integration failure costs more than a loud one.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      },
      {
        "text": "We build it and run real orders through it, including the ones that go wrong, before it touches live data.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      }
    ],
    "images": []
  },
