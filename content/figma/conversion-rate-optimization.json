  "process": {
    "texts": [
      {
        "text": "From audit to shipped change to measured.",
        "size": 40,
        "weight": 400,
        "family": "TWK Everett"
      },
      {
        "text": "How We Run CRO",
        "size": 15,
        "weight": 400,
        "family": "TWK Everett"
      },
      {
        "text": "Audit & Prioritise",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "Agree the Scope",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "We go through the funnel and score every problem on impact, effort and confidence, so the order of work is not a guess.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      },
      {
        "text": "We pick the quick wins and the bigger bets with you, and set what success looks like before starting.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      },
      {
        "text": "Measure & Repeat",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "Build & Test",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "We report what each change did and update the backlog, because CRO is a cycle rather than a one-off project.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      },
      {
        "text": "We implement the changes, and A/B test them where you have the traffic to make the result mean something.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      }
    ],
    "images": []
  },
