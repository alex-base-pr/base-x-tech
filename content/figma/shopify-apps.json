  "process": {
    "texts": [
      {
        "text": "From the workflow  to a working app.",
        "size": 40,
        "weight": 400,
        "family": "TWK Everett"
      },
      {
        "text": "How We Ship Apps",
        "size": 15,
        "weight": 400,
        "family": "TWK Everett"
      },
      {
        "text": "Scope the Workflow",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "Build & Review",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "We watch how the work happens now and decide what an app should do before we decide how it looks.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      },
      {
        "text": "We build against the Shopify APIs in reviewable stages, with your team using it as it takes shape.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      },
      {
        "text": "Test on Real Data",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "Launch & Maintain",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "We run it against real orders and real edge cases, because apps fail on the data nobody expected.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      },
      {
        "text": "We handle submission if it goes public, and keep it working through Shopify's API version changes.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      }
    ],
    "images": []
  },
