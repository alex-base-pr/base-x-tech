  "process": {
    "texts": [
      {
        "text": "From audit to a store that holds its traffic.",
        "size": 40,
        "weight": 400,
        "family": "TWK Everett"
      },
      {
        "text": "How We Migrate",
        "size": 15,
        "weight": 400,
        "family": "TWK Everett"
      },
      {
        "text": "Audit & Inventory",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "Plan & Map",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "We catalogue every URL, product, customer and integration on the old platform, because what gets missed is what gets lost.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      },
      {
        "text": "We map old URLs to new, decide what moves and what gets rebuilt, and agree the cutover before touching anything.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      },
      {
        "text": "Migrate & Verify",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "Launch & Watch",
        "size": 24,
        "weight": 500,
        "family": "TWK Everett"
      },
      {
        "text": "We move the data and check it against the source, then run the store on a staging build until it behaves.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      },
      {
        "text": "We import redirects, submit sitemaps and monitor Search Console for weeks after, not days.",
        "size": 16,
        "weight": 300,
        "family": "TWK Everett"
      }
    ],
    "images": []
  },
