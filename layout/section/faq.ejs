<% const sem = typeof semantic !== 'undefined' && semantic; %>
<section
  id="<%= (typeof id !== 'undefined' && id) ? id : '' %>"
  class="section section-split <%= (typeof extra_class !== 'undefined' && extra_class) ? extra_class : '' %> <% if (typeof theme !== 'undefined' && theme){ %>theme-<%= theme %><% } %> <%= (typeof locale !== 'undefined' && locale) ? ' locale-' + locale : '' %>">
  <div class="container">
    <% if (typeof title !== 'undefined' && title) { %>
      <div class="inner column-1">
        <header class="section-header">
          <% if (typeof title !== 'undefined' && title) { %>
            <% if (sem) { %><p class="section-title alt up"><%= title %></p><% } else { %><h2 class="section-title alt up"><%= title %></h2><% } %>
          <% } %>
          <% if (typeof subtitle !== 'undefined' && subtitle) { %>
            <% if (sem) { %><h2 class="section-subtitle up"><%- subtitle %></h2><% } else { %><h3 class="section-subtitle up"><%- subtitle %></h3><% } %>
          <% } %>
          <% if (typeof button !== 'undefined' && button) { %>
            <a class="btn btn--dark" data-form-trigger=""><span><%- button.text %></span><i arrow-right=""><span></span></i></a>
          <% } %>
        </header>
        <div>
          <% if (typeof faq !== 'undefined' && Array.isArray(faq) && faq.length > 0) { %>
            <component-accordion>
              <% faq.forEach((item, index) => { %>
                <article data-accordion-item="<% if (index === 0) { %>visible<% } else { %>hidden<% } %>">
                  <header class="faq-header">
                    <div class="header-inner">
                      <div>
                        <% if (typeof numbered === 'undefined' || numbered) { %><span class="stage"><%= (typeof stage_label !== 'undefined' && stage_label) ? stage_label : 'Stage' %> <%= index + 1 %></span><% } %>
                        <h3 class="title up"<% if (typeof schema !== 'undefined' && schema) { %> data-faq-q<% } %>><%- item.title %></h3>
                      </div>
                    </div>
                    <button class="toggle-button <% if (index === 0) { %>active<% } %>" aria-label="Show or hide details"></button>
                  </header>
                  <div class="inner-content">
                    <div class="inner">
                      <main class="description">
                        <p<% if (typeof schema !== 'undefined' && schema) { %> data-faq-a<% } %>><%- item.description %></p>
                      </main>
                    </div>
                  </div>
                </article>
              <% }) %>
            </component-accordion>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</section>
