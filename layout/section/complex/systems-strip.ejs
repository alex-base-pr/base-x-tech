<%# Systems strip (Figma #122: marquee). The list is in the HTML once; the moving copy is aria-hidden. %>
<section class="section section-systems-strip">
  <div class="container systems-strip">
    <p class="systems-strip--label"><%= label %></p>
    <div class="systems-strip--viewport">
      <ul class="systems-strip--track">
        <% items.forEach(item => { %><li><%= item %></li><% }) %>
      </ul>
      <ul class="systems-strip--track" aria-hidden="true">
        <% items.forEach(item => { %><li><%= item %></li><% }) %>
      </ul>
    </div>
  </div>
</section>
