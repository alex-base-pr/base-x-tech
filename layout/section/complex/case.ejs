<%# One strong case block (REQ-013). %>
<section id="<%= id %>" class="section section-case theme-light">
  <div class="container">
    <p class="section-title alt up case--label"><%= label %></p>
    <article class="case">
      <div class="case--intro">
        <h2 class="case--client up"><%= client %></h2>
        <p class="case--tags"><%= tags.join(' · ') %></p>
        <h3 class="case--h">The challenge</h3>
        <% challenge.forEach(p => { %><p><%= p %></p><% }) %>
      </div>
      <figure class="case--image">
        <% if (typeof image !== 'undefined' && image) { %><img loading="lazy" src="<%= image %>" alt="<%= client %>"><% } else { %><div class="case--placeholder" role="img" aria-label="Project image (placeholder)"></div><% } %>
      </figure>
      <div class="case--built">
        <h3 class="case--h">What we built</h3>
        <% built.forEach(p => { %><p><%= p %></p><% }) %>
      </div>
      <div class="case--outcomes">
        <h3 class="case--h">Key outcomes</h3>
        <ul>
          <% outcomes.forEach(o => { %><li><strong><%= o.title %></strong><span><%= o.text %></span></li><% }) %>
        </ul>
      </div>
    </article>
  </div>
</section>
