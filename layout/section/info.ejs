<section
  id="<%= (typeof id !== 'undefined' && id) ? id : '' %>"
  class="section section-works <% if (typeof theme !== 'undefined' && theme){ %>theme-<%= theme %><% } %> <%= (typeof locale !== 'undefined' && locale) ? ' locale-' + locale : '' %> <%= (typeof background_image !== 'undefined' && background_image) ? 'has-back' : '' %> "
  style="<%= (typeof background_image !== 'undefined' && background_image) ? '--background-image: url(' + background_image + ');' : '' %> <%= (typeof background_image_mobile !== 'undefined' && background_image_mobile) ? '--background-image-mob: url(' + background_image_mobile + ');' : '' %>"
  >
  <div class="container">
    <% if (typeof title !== 'undefined' && title) { %>
      <div class="inner">
        <header class="section-header">
          <% if (typeof title !== 'undefined' && title) { %>
            <h2 class="section-title alt up"><%= title %></h2>
          <% } %>
          <% if (typeof subtitle !== 'undefined' && subtitle) { %>
            <h3 class="section-subtitle up"><%- subtitle %></h3>
          <% } %>
        </header>
        <blockquote>
          <% if (typeof list !== 'undefined' && list) { %>
            <ul class="marker-list">
              <% list.forEach(item => { %>
                <li><%= item.title %></li>
              <% }) %>
            </ul>
          <% } %>

          <% if (typeof cards !== 'undefined' && cards) { %>
            <ul class="marker-list">
              <% cards.forEach(item => { %>
                <li class="custom-card">
                  <h3 class="custom-card--title"><%- item.title %></h3>
                  <h4 class="custom-card--subtitle"><%- item.subtitle %></h4>
                  <% if (typeof item.background_image !== 'undefined' && item.background_image) { %>
                    <div class="custom-card--image">
                      <img loading="lazy" fetchpriority="low" src="<%= item.background_image %>" alt="Naya Tech" class="card-background">
                    </div>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          <% } %>

          <% if (typeof reviews !== 'undefined' && reviews) { %>
            <div class="carousel type-2" id="reviews-carousel">
              <% reviews.forEach(item => { %>
                <div class="info-card style-1 block-stack" style="--gap:2rem">
                  <header>
                    <img class="icon-quote" loading="lazy" fetchpriority="low" src="/images/icons/quote.svg">
                    <p class="text"><%= item.text %></p>
                  </header>
                  <footer class="block-stack" style="--gap: .3rem;">
                    <div class="avatar" style="--avatar-size: 64px;">
                      <img loading="lazy" fetchpriority="low" src="<%= item.avatar %>" alt="<%= item.name %>">
                    </div>
                    <div>
                      <h4 class="title def"><%= item.name %></h4>
                      <p class="subtitle"><%= item.post %></p>
                    </div>
                  </footer>
                </div>
              <% }) %>
            </div>
            <nav class="slider-nav inline-stack" style="--gap:.75rem">
              <button class="slider-nav-btn prev">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5.60222 10.325H17.4805V7.67503H5.60222L10.8912 2.38578L8.99997 0.519531L0.519472 9.00003L8.99997 17.4805L10.8912 15.6143L5.60222 10.325Z" fill="black"/>
                </svg>
              </button>
              <button class="slider-nav-btn next">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12.3978 10.325H0.519531V7.67503H12.3978L7.10878 2.38578L9.00003 0.519531L17.4805 9.00003L9.00003 17.4805L7.10878 15.6143L12.3978 10.325Z" fill="black"/>
                </svg>
              </button>
            </nav>
          <% } %>
        </blockquote>
      </div>
    <% } %>
  </div>
</section>
