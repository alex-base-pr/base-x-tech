<section
  class="section section-default <% if (typeof theme !== 'undefined' && theme){ %>theme-<%= theme %><% } %> <%= (typeof locale !== 'undefined' && locale) ? ' locale-' + locale : '' %>" id="<%= id || 'price-brief' %>"
  style="<%= (typeof background_image !== 'undefined' && background_image) ? '--background-image: url(' + background_image + ');' : '' %> <%= (typeof background_image_mobile !== 'undefined' && background_image_mobile) ? '--background-image-mob: url(' + background_image_mobile + ');' : '' %>"
>
  <div class="container">
    <div class="section-header">
      <% if (typeof subtitle !== 'undefined') { %>
        <h2 class="section-title"><%- title %></h2>
      <% } %>

      <% if (typeof title !== 'undefined') { %>
        <h3 class="section-subtitle"><%- subtitle %></h3>
      <% } %>
    </div>

    <% if (typeof cards !== 'undefined') { %>
      <% if (Array.isArray(cards) && cards.length > 0) { %>
        <div class="pricing-grid">
          <% cards.forEach(card => { %>
            <div class="pricing-card <%= card.class || '' %>">
              <div>
                <div class="pricing-card--header">
                  <% if (card.number) { %>
                    <div class="pricing-card--number"><%= card.number %></div>
                  <% } %>

                  <% if (card.title) { %>
                    <h3 class="pricing-card--title"><%= card.title %></h3>
                  <% } %>

                  <% if (card.subtitle) { %>
                    <div class="pricing-card--duration"><%= card.subtitle %></div>
                  <% } %>

                  <% if (card.description) { %>
                    <p class="pricing-card--description"><%= card.description %></p>
                  <% } %>
                </div>

                <div class="pricing-card--body">
                  <% if (card.listTitle) { %>
                    <p class="pricing-card--list-title"><%= card.listTitle %></p>
                  <% } %>

                  <% if (Array.isArray(card.listItems) && card.listItems.length > 0) { %>
                    <ul class="pricing-card--list">
                      <% card.listItems.forEach(item => { %>
                        <% if (item) { %>
                          <li><span class="checkmark-icon"></span> <%= item %></li>
                        <% } %>
                      <% }) %>
                    </ul>
                  <% } %>
                </div>
              </div>

              <div class="pricing-card--footer">
                <% if (card.button.text) { %>

                <a data-form-trigger style="justify-content: center;" class="btn <% if (typeof card.button.style !== 'undefined' && card.button.style){ %><%= card.button.style %><% } %>"><span><%= card.button.text %></span></a>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    <% } %>
  </div>
</section>
