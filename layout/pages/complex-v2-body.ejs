<%# Complex Solutions / DACH page, design v2 (Figma "Complex" 877:1584). Copy: content/pages/complex-solutions.<lang>.json (REQ-013…019).
    All text is in the HTML. Every CTA opens our contact drawer (REQ-018): no direct contacts of the partner, no logos of his clients (REQ-016).
    FAQ = the page's own DACH questions (M2, 2026-09-25) → data-faq-q/a → FAQPage schema (scripts/seo-plugin.js). %>
<%
  const btn = (text) => include('layout/v2/button.ejs', { text });
  const pad2 = (i) => String(i + 1).padStart(2, '0');
%>
<% const ui = Object.assign({}, content.shell.en.ui, (content.shell[lang] || {}).ui); const href = (u) => localHref(u, lang); const localHtml = (h) => String(h ?? '').replace(/href=(['"])(\/[^'"]*)\1/g, (m, q, u) => 'href=' + q + localHref(u, lang) + q); -%>
<body class="v2 cx-page locale-<%= lang %>" lang="<%= lang %>">
  <%- include('layout/noscript.ejs') %>
  <%- include('layout/v2/header.ejs') %>
  <%- include('layout/v2/nav.ejs') %>
  <%- include('layout/v2/form.ejs', { cxPage: true }) %>

  <nav class="v2-rail" aria-hidden="true"><span class="is-active"></span><span></span><span></span><span></span><span></span><span></span></nav>

  <main id="complex-solutions" class="v2-main cx" data-service="Complex Solutions (ERP, POS, middleware)">

    <%# Hero + systems strip (REQ-015; K1 2026-09-25: one strip, caption "Systems we connect", list from Marko's Figma comment).
        DACH review 2026-09-30: eyebrow, title, ONE paragraph, CTA, free-call note — nothing else before the CTA. %>
    <section class="cx-hero" data-v2-section>
      <div class="cx-hero__body">
        <p class="cx-label cx-label--dark"><%= c.hero.eyebrow %></p>
        <h1 class="cx-hero__title"><%- localHtml(c.hero.title) %></h1>
        <p class="cx-hero__lead"><%= c.hero.lead %></p>
        <div class="cx-btn cx-btn--light"><%- localHtml(btn(c.hero.button)) %></div>
        <%- include('layout/v2/cta-note.ejs') %>
      </div>
      <div class="cx-strip">
        <p class="cx-strip__label"><%= c.strip.label %></p>
        <div class="cx-strip__viewport">
          <ul class="cx-strip__track">
            <% c.strip.items.forEach(item => { %><li><%= item %></li><% }) %>
          </ul>
          <ul class="cx-strip__track" aria-hidden="true">
            <% c.strip.items.forEach(item => { %><li><%= item %></li><% }) %>
          </ul>
        </div>
      </div>
    </section>

    <%# Typical situations (DACH review 2026-09-30): second section, five text cards. Replaces "When we can help",
        whose three cards live on here as (b)–(d). %>
    <section class="cx-section cx-cases" id="typical-situations" data-v2-section>
      <header class="cx-head">
        <p class="cx-label"><%= c.useCases.label %></p>
        <h2 class="cx-h2"><%- localHtml(c.useCases.title) %></h2>
      </header>
      <ul class="cx-cases__grid">
        <% c.useCases.cards.forEach(card => { %>
          <li class="cx-card">
            <h3 class="cx-h3 cx-h3--s"><%= card.title %></h3>
            <p><%= card.description %></p>
          </li>
        <% }) %>
      </ul>
      <div class="cx-btn cx-btn--dark"><%- localHtml(btn(c.hero.button)) %></div>
    </section>

    <%# Partner block (REQ-013/016/017/018; M1/M5/K2 2026-09-25): photo approved by the owner 2026-09-25
        (public/images/v2/alexander-karl.webp) — no quote, no placeholder, no email/phone/calendar. Without c.partner.photo the block is text-only. LinkedIn only if c.partner.linkedin is set. %>
    <section class="cx-section cx-partner<%= c.partner.photo ? '' : ' cx-partner--text' %>" id="local-expertise" data-v2-section>
      <% if (c.partner.photo) { %>
      <figure class="cx-partner__photo">
        <img loading="lazy" src="<%= c.partner.photo %>" width="1335" height="1257" alt="<%= c.partner.photoAlt || (c.partner.name + ', ' + c.partner.role) %>">
      </figure>
      <% } %>
      <div class="cx-partner__body">
        <h2 class="cx-label"><%= c.partner.label %></h2>
        <p class="cx-partner__person"><strong><%= c.partner.name %></strong><span><%= c.partner.role %></span><% if (c.partner.linkedin) { %><a href="<%= c.partner.linkedin %>" target="_blank" rel="noopener">LinkedIn</a><% } %></p>
        <div class="cx-partner__text">
          <% c.partner.paragraphs.forEach(p => { %><p><%= p %></p><% }) %>
        </div>
        <% if (c.partner.bio) { %><p class="cx-partner__bio"><%= c.partner.bio %></p><% } %>
        <% if (c.partner.inPerson) { %><p class="cx-partner__inperson"><%= c.partner.inPerson %></p><% } %>
      </div>
    </section>

    <%# Capabilities: four solution types (DACH review 2026-09-30: "exactly the right things, no fluff") %>
    <section class="cx-section cx-caps" id="capabilities" data-v2-section>
      <header class="cx-head">
        <p class="cx-label"><%= c.capabilities.label %></p>
        <h2 class="cx-h2"><%- localHtml(c.capabilities.title) %></h2>
      </header>
      <ul class="cx-caps__grid">
        <% c.capabilities.cards.forEach(card => { %>
          <li class="cx-caps__item">
            <h3 class="cx-h3"><%= card.title %></h3>
            <p><%= card.description %></p>
          </li>
        <% }) %>
      </ul>
    </section>

    <%# What an integration really includes (REQ-014) %>
    <section class="cx-section cx-text" id="behind-the-integration" data-v2-section>
      <header class="cx-head">
        <p class="cx-label"><%= c.reliable.label %></p>
        <h2 class="cx-h2"><%- localHtml(c.reliable.title) %></h2>
      </header>
      <div class="cx-text__body">
        <% c.reliable.paragraphs.forEach(p => { %><p><%= p %></p><% }) %>
      </div>
      <div class="cx-btn cx-btn--dark"><%- localHtml(btn(c.reliable.button)) %></div>
    </section>

    <%# Architecture (DACH review 2026-09-30): generic, not the case-specific diagram — store → our middleware → your systems.
        Plain HTML (text for screen readers, search engines and AI assistants), no arrow labels. One markup: a fan-out
        on wide screens, a vertical "bus" on phones (CSS only). The case section below describes the concrete project. %>
    <% const d = c.architecture.diagram; %>
    <section class="cx-section cx-arch" id="system-architecture" data-v2-section>
      <header class="cx-head">
        <p class="cx-label"><%= c.architecture.label %></p>
        <h2 class="cx-h2"><%- localHtml(c.architecture.title) %></h2>
        <% c.architecture.paragraphs.forEach(p => { %><p class="cx-head__lead"><%= p %></p><% }) %>
      </header>
      <figure class="cx-diagram" role="img" aria-labelledby="cx-flow-desc">
        <p class="cx-sr" id="cx-flow-desc"><%= d.desc %></p>
        <div class="cx-flow">
          <div class="cx-flow__node cx-flow__node--store">
            <svg class="cx-flow__icon" viewBox="0 0 28 28" aria-hidden="true"><path d="M4 10h20l-2-6H6z M6 10v14h16V10 M11 24v-8h6v8"/></svg>
            <span><%= d.store %></span>
          </div>
          <div class="cx-flow__link"></div>
          <div class="cx-flow__node cx-flow__node--mid">
            <svg class="cx-flow__icon" viewBox="0 0 28 28" aria-hidden="true"><path d="M3 9l11-6 11 6-11 6z M3 14l11 6 11-6 M3 19l11 6 11-6"/></svg>
            <span><%= d.middleware %></span>
          </div>
          <ul class="cx-flow__systems">
            <% d.systems.forEach(s => { %><li class="cx-flow__node"><span><%= s %></span></li><% }) %>
            <li class="cx-flow__node cx-flow__node--any"><span><%= d.any %></span></li>
          </ul>
        </div>
      </figure>
    </section>

    <%# Case (A49, 2026-09-25): Marko's case copy from Figma. End client named with permission (owner, 2026-09-25). %>
    <section class="cx-section cx-case" id="proven-in-practice" data-v2-section>
      <p class="cx-label cx-case__label"><%= c.case.label %></p>
      <article class="cx-case__card">
        <div class="cx-case__intro">
          <h2 class="cx-case__client"><%= c.case.client %></h2>
          <% if (c.case.descriptor) { %><p class="cx-case__descriptor"><%= c.case.descriptor %></p><% } %>
          <p class="cx-case__tags"><%= c.case.tags.join(' · ') %></p>
          <h3 class="cx-case__h"><%= c.case.challengeTitle %></h3>
          <% c.case.challenge.forEach(p => { %><p><%= p %></p><% }) %>
        </div>
        <figure class="cx-case__media">
          <% if (c.case.image) { %>
            <img loading="lazy" src="<%= c.case.image %>" alt="<%= c.case.client %>">
          <% } else { %>
            <div class="cx-case__placeholder" role="img" aria-label="<%= c.case.imagePlaceholder %>">
              <svg width="120" height="120" viewBox="0 0 120 120" aria-hidden="true"><rect width="120" height="120" rx="12" fill="currentColor" opacity=".12"/><circle cx="84" cy="44" r="9" fill="#fff"/><path d="M22 92 48 58l16 20 10-12 24 26z" fill="#fff"/></svg>
            </div>
          <% } %>
        </figure>
        <div class="cx-case__panel">
          <h3 class="cx-case__h"><%= c.case.builtTitle %></h3>
          <% c.case.built.forEach(p => { %><p><%= p %></p><% }) %>
        </div>
        <div class="cx-case__panel">
          <h3 class="cx-case__h"><%= c.case.outcomesTitle %></h3>
          <ul class="cx-case__outcomes">
            <% c.case.outcomes.forEach(o => { %><li><h4><%= o.title %></h4><p><%= o.text %></p></li><% }) %>
          </ul>
        </div>
        <% if (c.case.footer) { %><p class="cx-case__footer"><%= c.case.footer %></p><% } %>
      </article>
    </section>

    <%# Blog teasers — real Ghost posts only %>
    <section class="cx-section cx-posts" id="go-deeper" data-v2-section>
      <div class="cx-posts__intro">
        <h2 class="cx-label"><%= c.posts.label %></h2>
        <p><%= c.posts.text %></p>
      </div>
      <ul class="cx-posts__list">
        <% c.posts.items.forEach(post => { %>
          <li class="cx-post">
            <p class="cx-post__meta"><span><%= c.posts.by %> <%= post.author %></span><time datetime="<%= post.datetime %>"><%= post.date %></time></p>
            <h3 class="cx-post__title"><a href="<%= post.url %>"><%= post.title %></a></h3>
            <p class="cx-post__excerpt"><%= post.excerpt %></p>
            <a class="cx-post__more" href="<%= post.url %>" aria-hidden="true" tabindex="-1"><%= c.posts.readMore %></a>
          </li>
        <% }) %>
      </ul>
    </section>

    <%# Process (4 steps) %>
    <section class="cx-section cx-process" id="process" data-v2-section>
      <header class="cx-head">
        <p class="cx-label"><%= c.process.label %></p>
        <h2 class="cx-h2"><%- localHtml(c.process.title) %></h2>
      </header>
      <ol class="cx-process__grid">
        <% c.process.steps.forEach((step, i) => { %>
          <li class="cx-card cx-process__card">
            <span class="cx-process__num"><span class="cx-sr"><%= c.process.stagePrefix %> </span><%= pad2(i) %></span>
            <div>
              <h3 class="cx-h3"><%= step.title %></h3>
              <p><%= step.description %></p>
            </div>
          </li>
        <% }) %>
      </ol>
      <div class="cx-btn cx-btn--dark"><%- localHtml(btn(c.process.button)) %></div>
    </section>

    <% if (c.offer) { %><%- include('layout/v2/offer.ejs', { offer: c.offer }) %><% } %>

    <%# FAQ — the page's own questions (M2); data-faq-q/a feed the FAQPage schema like on the service pages. %>
    <section class="cx-section cx-faq" id="faq" data-v2-section>
      <header class="cx-head">
        <p class="cx-label"><%= c.faq.label %></p>
        <h2 class="cx-h2"><%- localHtml(c.faq.title) %></h2>
      </header>
      <div class="cx-faq__list">
        <% c.faq.items.forEach((f, i) => { %>
          <details class="cx-faq__item" <%= i === 0 ? 'open' : '' %>>
            <summary><h3 data-faq-q><%= f.q %></h3><span class="cx-faq__toggle" aria-hidden="true"></span></summary>
            <p data-faq-a><%= f.a %></p>
          </details>
        <% }) %>
      </div>
    </section>

    <% if (c.related && c.related.items.length) { %>
    <nav class="v2-related cx-related" aria-label="<%= c.related.label %>">
      <p class="v2-related__label"><%= c.related.label %></p>
      <ul class="v2-related__list">
        <% c.related.items.forEach(r => { %><li><a href="<%= href(r.href) %>"><%= r.name %><svg width="10" height="10" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 12 12 2M4 2h8v8" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></a></li><% }) %>
      </ul>
    </nav>
    <% } %>

    <%# Closing CTA %>
    <section class="cx-cta" id="contact" data-v2-section>
      <p class="cx-label cx-label--dark"><%= c.cta.label %></p>
      <h2 class="cx-h2"><%- localHtml(c.cta.title) %></h2>
      <p class="cx-cta__body"><%= c.cta.body %></p>
      <div class="cx-btn cx-btn--light"><%- localHtml(btn(c.cta.button)) %></div>
      <%- include('layout/v2/cta-note.ejs') %>
      <%- include('layout/v2/team.ejs', { teamDach: typeof teamDach === 'undefined' ? true : teamDach }) %>
    </section>
  </main>

  <%- include('layout/v2/footer.ejs') %>

  <script type="module" src="/src/main.js"></script>
  <script type="module" src="/src/v2.js"></script>
</body>
