<%# Design v2 contact modal (Figma "Modal-form" 825:33 / "Modal-mobile" 825:122).
    Field names and #task-form / #success-msg / .form-select are what src/main.js submits to ClickUp — keep them.
    Strings: content/pages/shell.<lang>.json (EN default). Option values stay English so every lead reads the same;
    the service is pre-selected from <main data-service> (src/v2.js). Budget has no default (optional); bands are in EUR (A3).
    Contact-form review 2026-09-30 (docs/review/2026-09-30-contact-form.md): layout back to Figma sizes, company → website,
    "How did you find us?" moved out of the form into #source-form in the success state (sent as a second ClickUp task). %>
<% const L = typeof lang !== 'undefined' ? lang : 'en'; const sh = content.shell[L] || content.shell.en; const href = (u) => localHref(u, L); const f = sh.form;
   const complexPage = typeof cxPage !== 'undefined' && cxPage; // A3: no "Up to €5k" band on Complex pages %>
<div class="v2-modal" role="dialog" aria-modal="true" aria-labelledby="v2-modal-title">
  <div class="v2-modal__overlay" data-form-close></div>
  <div class="v2-modal__panel">
    <button type="button" class="v2-modal__close" data-form-close aria-label="<%= f.close %>">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2l12 12M14 2 2 14" stroke="currentColor" stroke-width="1.6"/></svg>
    </button>
    <h2 class="v2-modal__title" id="v2-modal-title"><%= f.title %> <span><%= f.titleMuted %></span></h2>

    <div id="success-msg" class="v2-modal__state" role="status">
      <p class="v2-modal__state-title"><%= f.successTitle %></p>
      <p><%= f.successBefore %> <a href="mailto:hello@base-xtech.com">hello@base-xtech.com</a>.</p>
      <form id="source-form" class="v2-source">
        <fieldset>
          <legend><%= f.sourceLabel %> <span><%= f.sourceOptional %></span></legend>
          <div class="v2-source__chips">
            <% f.sources.forEach(o => { %><button type="submit" name="source" value="<%= o.value %>"><%= o.label %></button>
            <% }) %>
          </div>
        </fieldset>
        <p class="v2-source__thanks" role="status" hidden><%= f.sourceThanks %></p>
      </form>
      <button type="button" class="v2-modal__secondary" data-form-close><%= f.closeButton %></button>
    </div>
    <div id="error-msg" class="v2-modal__state" role="alert">
      <p class="v2-modal__state-title"><%= f.errorTitle %></p>
      <p><%= f.errorBefore %> <a href="mailto:hello@base-xtech.com">hello@base-xtech.com</a>.</p>
      <button type="button" class="v2-modal__secondary" data-form-retry><%= f.retry %></button>
    </div>

    <form id="task-form" class="v2-form" toolname="request_project_quote" tooldescription="Send a project inquiry to Base X Tech (Shopify development, integrations, migrations, custom apps, web design, CRO, ERP/POS systems). A person replies within 1 working day; the first call is free.">
      <div class="v2-form__row">
        <label><span class="v2-sr"><%= f.nameLabel %></span><input required name="name" toolparamdescription="Full name of the person asking" type="text" autocomplete="name" placeholder="<%= f.namePlaceholder %>"></label>
        <label><span class="v2-sr"><%= f.emailLabel %></span><input required name="email" toolparamdescription="Work email for the reply" type="email" autocomplete="email" placeholder="<%= f.emailPlaceholder %>"></label>
      </div>
      <div class="v2-form__row">
        <label><span class="v2-sr"><%= f.phoneLabel %></span><input name="phone" toolparamdescription="Phone number, optional" type="tel" autocomplete="tel" placeholder="<%= f.phonePlaceholder %>"></label>
        <label><span class="v2-sr"><%= f.companyLabel %></span><input name="company" toolparamdescription="Website or Shopify store URL, optional" type="text" inputmode="url" autocomplete="url" autocapitalize="off" spellcheck="false" placeholder="<%= f.companyPlaceholder %>"></label>
      </div>
      <label class="v2-form__field">
        <span><%= f.serviceLabel %></span>
        <select name="service" class="form-select" toolparamdescription="Which service the project needs">
          <% f.services.forEach(o => { %><option value="<%= o.value %>" data-lead="<%= o.value %>"><%= o.label %></option>
          <% }) %>
        </select>
      </label>
      <fieldset class="v2-form__field v2-form__budget">
        <legend><%= f.budgetLegend %></legend>
        <div>
          <% f.budgets.filter(b => !(complexPage && b.hideOnComplex)).forEach(b => { %><label><input type="radio" name="budget" toolparamdescription="Project budget in EUR, optional" value="<%= b.value %>"><span><%= b.label %></span></label>
          <% }) %>
        </div>
      </fieldset>
      <label class="v2-form__field">
        <span><%= f.messageLabel %></span>
        <textarea name="tell_us_more" toolparamdescription="Project details: platform, systems involved, goal and deadline" rows="3" placeholder="<%= f.messagePlaceholder %>"></textarea>
      </label>
      <button type="submit" class="v2-btn v2-btn--wide"><span class="v2-btn__label"><%= f.submit %></span><span class="v2-btn__arrow" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 2l10 10M12 4v8H4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></span></button>
      <p class="v2-form__promise"><%= sh.ctaNote || f.promise %></p>
      <p class="v2-form__note"><%= f.note %> <a href="<%= f.privacyHref || href('/pages/privacy-policy/') %>"><%= f.privacy %></a></p>
    </form>
  </div>
</div>
