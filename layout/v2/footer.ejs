<%# Design v2 footer. Strings: content/pages/shell.<lang>.json (EN default). %>
<% const sh = content.shell[typeof lang !== 'undefined' && content.shell[lang] ? lang : 'en']; %>
<footer class="v2-footer">
  <div class="v2-footer__grid">
    <div class="v2-footer__brand">
      <a href="/" aria-label="<%= sh.homeLabel %>" class="v2-footer__logo">
        <svg width="56" height="32" viewBox="0 0 112 64" aria-hidden="true"><path d="M79.9898 11.6328L91.6225 0H112V20.3709L100.367 32.0038L112 43.6367V64.0004H91.6226L79.9898 52.3675L68.3571 64.0004H48.0006V43.6298L59.6265 32.0038L48.0006 20.3777V0H68.3572L79.9898 11.6328Z" fill="currentColor"/><path d="M0 7.50943e-06H28.0016L47.9997 19.9983V42.0023L47.9979 42.0041V20.3596L36.3616 31.996L47.1837 42.8183L26.0019 64.0004H0V43.6238L11.6276 31.996L0 20.3683V7.50943e-06Z" fill="currentColor"/></svg>
      </a>
      <div class="v2-footer__meta">
        <% if (sh.footer.company) { %><p class="v2-footer__company"><%= sh.footer.company %></p><% } %>
        <p class="v2-footer__copy">© <%= new Date().getFullYear() %> Base X Tech. <%= sh.footer.rights %></p>
      </div>
    </div>
    <nav class="v2-footer__col" aria-label="<%= sh.nav.footer %>">
      <p class="v2-footer__label"><%= sh.footer.navigation %></p>
      <a href="/pages/shopify-development/"><%= sh.nav.services %></a>
      <a href="/#section-works"><%= sh.nav.portfolio %></a>
      <a href="/blog/"><%= sh.nav.insights %></a>
      <a href="/#section-team"><%= sh.nav.about %></a>
      <a href="#contact" data-form-trigger><%= sh.nav.contact %></a>
    </nav>
    <div class="v2-footer__col">
      <p class="v2-footer__label"><%= sh.footer.connect %></p>
      <a href="https://www.upwork.com/agencies/base/" target="_blank" rel="noopener">Upwork</a>
      <a href="https://www.linkedin.com/company/base-x-tech/" target="_blank" rel="noopener">LinkedIn</a>
      <a href="https://www.behance.net/base-xtech" target="_blank" rel="noopener">Behance</a>
    </div>
  </div>
  <div class="v2-footer__legal">
    <a href="/pages/terms-and-conditions/"><%= sh.footer.terms %></a>
    <a href="/pages/privacy-policy/"><%= sh.footer.privacy %></a>
  </div>
</footer>
