<%# Design v2 header (Figma "Service Page"): logo in the rail, pill navigation, language globe, CTA. %>
<header class="v2-header">
  <a href="/" class="v2-header__logo" aria-label="Base X Tech home">
    <svg width="44" height="25" viewBox="0 0 112 64" aria-hidden="true"><path d="M79.9898 11.6328L91.6225 0H112V20.3709L100.367 32.0038L112 43.6367V64.0004H91.6226L79.9898 52.3675L68.3571 64.0004H48.0006V43.6298L59.6265 32.0038L48.0006 20.3777V0H68.3572L79.9898 11.6328Z" fill="currentColor"/><path d="M0 7.50943e-06H28.0016L47.9997 19.9983V42.0023L47.9979 42.0041V20.3596L36.3616 31.996L47.1837 42.8183L26.0019 64.0004H0V43.6238L11.6276 31.996L0 20.3683V7.50943e-06Z" fill="currentColor"/></svg>
  </a>
  <nav class="v2-header__nav" aria-label="Main">
    <div class="v2-nav-item v2-nav-item--services">
      <button type="button" class="v2-pill" aria-expanded="false" aria-controls="v2-services-menu" data-v2-services>Services</button>
      <div class="v2-services-menu" id="v2-services-menu" hidden>
        <a href="/pages/shopify-development/">Shopify Development</a>
        <a href="/pages/service/custom-shopify-app-development/">Custom Shopify Apps</a>
        <a href="/pages/service/custom-shopify-integrations/">Shopify Integrations</a>
        <a href="/pages/service/shopify-migration-service/">Shopify Migration</a>
        <a href="/pages/service/custom-web-design-services/">Web Design</a>
        <a href="/pages/service/conversion-rate-optimization/">Conversion Rate Optimization</a>
        <a href="/pages/complex-solutions/">Complex Solutions (DACH)</a>
      </div>
    </div>
    <a class="v2-pill" href="/#section-works">Portfolio</a>
    <a class="v2-pill" href="/blog/">Insights</a>
    <a class="v2-pill" href="/#section-team">About</a>
    <a class="v2-pill" href="#" data-form-trigger>Contact</a>
  </nav>
  <div class="v2-header__actions">
    <div class="v2-lang">
      <button type="button" class="v2-pill v2-pill--icon" aria-label="Language" data-v2-lang>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19M12 2.5c2.6 2.8 3.9 6 3.9 9.5s-1.3 6.7-3.9 9.5c-2.6-2.8-3.9-6-3.9-9.5s1.3-6.7 3.9-9.5Z"/></svg>
      </button>
      <div class="v2-lang__menu" hidden><%- include('layout/component/lang-switcher.ejs') %></div>
    </div>
    <a href="#" class="v2-pill v2-pill--accent" data-form-trigger>Let’s talk</a>
    <button type="button" class="v2-pill v2-header__burger" aria-label="Menu" data-nav-trigger>
      <span></span><span></span>
    </button>
  </div>
</header>
