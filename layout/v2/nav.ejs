<%# Design v2 mobile menu (Figma "Mobile menu" 693:1574): pill list, Services opens a card grid, social tiles.
    Strings and service cards: content/pages/shell.<lang>.json (EN default). %>
<% const L = typeof lang !== 'undefined' ? lang : 'en'; const sh = content.shell[L] || content.shell.en; const href = (u) => localHref(u, L); %>
<div class="v2-mnav" id="v2-mnav">
  <nav class="v2-mnav__panel" aria-label="<%= sh.nav.mobile %>">
    <div class="v2-mnav__level" data-v2-mnav-main>
      <ul class="v2-mnav__list">
        <li><button type="button" class="v2-mnav__item" data-v2-mnav-open aria-expanded="false" aria-controls="v2-mnav-services"><%= sh.nav.services %> <svg width="7" height="10" viewBox="0 0 7 10" aria-hidden="true"><path d="M1 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button></li>
        <li><a class="v2-mnav__item" href="<%= href('/#section-works') %>" data-nav-trigger><%= sh.nav.portfolio %></a></li>
        <li><a class="v2-mnav__item" href="/blog/"><%= sh.nav.insights %></a></li>
        <li><a class="v2-mnav__item" href="<%= href('/#section-team') %>" data-nav-trigger><%= sh.nav.about %></a></li>
        <li><a class="v2-mnav__item" href="#contact" data-form-trigger data-nav-trigger><%= sh.nav.contact %></a></li>
      </ul>
    </div>
    <div class="v2-mnav__level" id="v2-mnav-services" data-v2-mnav-sub hidden>
      <button type="button" class="v2-mnav__item v2-mnav__back" data-v2-mnav-back><svg width="7" height="10" viewBox="0 0 7 10" aria-hidden="true"><path d="M6 1 2 5l4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg> <%= sh.nav.back %></button>
      <ul class="v2-mnav__grid">
        <% sh.mobileServices.forEach(({ name, href: link, image }) => { %>
          <li><a class="v2-mnav__card" href="<%= localHref(link, L) %>">
            <span class="v2-mnav__thumb"><% if (image) { %><img loading="lazy" src="<%= image %>" alt=""><% } %></span>
            <span class="v2-mnav__name"><%= name %> <svg width="10" height="10" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 12 12 2M4 2h8v8" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></span>
          </a></li>
        <% }) %>
      </ul>
    </div>
    <ul class="v2-mnav__social">
      <li><a href="https://www.upwork.com/agencies/base/" target="_blank" rel="noopener">Upwork</a></li>
      <li><a href="https://www.linkedin.com/company/base-x-tech/" target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a href="https://www.behance.net/base-xtech" target="_blank" rel="noopener">Behance</a></li>
    </ul>
  </nav>
</div>
