<div class="drawer-form--wrapper">
  <div class="container">
    <header class="drawer-form--header">
      <a href="#" class="logo">
        <svg width="112" height="64" viewBox="0 0 112 64" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M79.9898 11.6328L91.6225 0H112V20.3709L100.367 32.0038L112 43.6367V64.0004H91.6226L79.9898 52.3675L68.3571 64.0004H48.0006V43.6298L59.6265 32.0038L48.0006 20.3777V0H68.3572L79.9898 11.6328Z" fill="#FAFAFA"/>
          <path d="M0 7.50943e-06H28.0016L47.9997 19.9983V42.0023L47.9979 42.0041V20.3596L36.3616 31.996L47.1837 42.8183L26.0019 64.0004H0V43.6238L11.6276 31.996L0 20.3683V7.50943e-06Z" fill="#FAFAFA"/>
        </svg>
        <span class="logo-text up">Base X</span>
      </a>
      <span class="btn--rounded-close" data-form-close>
        <img loading="lazy" fetchpriority="low" src="/images/icons/close.svg" alt="close">
      </span>
    </header>
    <div class="scroller">
      <nav class="drawer-form">
        <h5 class="drawer-form--title up">let’s discuss a project</h5>
        <div id="success-msg">
          <header>
            <h5 class="up">thanks you for<br> submitting the form</h5>
            <p>We will back shortly to you with response.</p>
          </header>
          <footer>
            <a data-form-close href="#" class="btn btn--primary up">Close the form</a>
          </footer>
        </div>
        <form id="task-form" action="" class="form">
          <div class="form-block grid-desk-2">
            <label class="form-label">
              <span>name *</span>
              <input required name="name" type="text" class="form-input" placeholder="Full name">
            </label>
            <label class="form-label">
              <span>Email *</span>
              <input required name="email" type="email" class="form-input" placeholder="name@website.com">
            </label>
            <label class="form-label">
              <span>Phone *</span>
              <input required name="phone" type="phone" class="form-input" placeholder="e.g. +1 395 495 994">
            </label>
            <label class="form-label">
              <span>Company *</span>
              <input required name="company" type="text" class="form-input" placeholder="e.g. Inditex">
            </label>
          </div>
          <div class="form-block">
            <label class="form-label">
              <span>Service required</span>
              <select name="service" class="form-select" placeholder="Tell us about your project">
                <option value="1">Shopify Development</option>
                <option value="2">Website Design</option>
                <option value="3">Custom Development</option>
                <option value="4">API Integration</option>
                <option value="5">Theme Store</option>
              </select>
            </label>
          </div>
          <div class="form-block">
              <label class="form-label">
                <span>What’s your budget</span>
              </label>
              <div class="form-radio-custom budget-options">
                <label>
                  <input type="radio" name="budget" value="2k" checked>
                  <span>$2k</span>
                </label>
                <label>
                    <input type="radio" name="budget" value="5k">
                    <span>$5k+</span>
                </label>
                <label>
                    <input type="radio" name="budget" value="10k">
                    <span>$10k+</span>
                </label>
                <label>
                    <input type="radio" name="budget" value="25k">
                    <span>$25k+</span>
                </label>
              </div>
          </div>
          <div class="form-block">
            <label class="form-label">
              <span>Tell us more if you need</span>
              <textarea name="tell_us_more" class="form-textarea" placeholder="Type here any details that you want to discuss or details not mentioned before"></textarea>
            </label>
          </div>
          <div class="form-block">
            <button class=" btn btn--dark up" type="submit"><span>Send</span></button>
          </div>
        </form>
      </nav>
    </div>
  </div>
</div>
